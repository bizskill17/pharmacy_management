# Copy this file to .env and fill in your own values. Never commit .env.

# Required in production: a long random secret used to sign login sessions.
# Create one with: openssl rand -hex 32
SESSION_SECRET=

# The first Admin account, created when the database has no users.
ADMIN_NAME=Admin
ADMIN_PHONE=
ADMIN_PASSWORD=

# PostgreSQL connection. Leave blank to use the built-in local database in ./data.
DATABASE_URL=
# Set to true if your database host requires SSL.
DATABASE_SSL=false

# Where uploaded photos are stored. Defaults to ./data/uploads.
UPLOAD_DIR=

# Set to false only when testing over plain http in production mode.
COOKIE_SECURE=true
